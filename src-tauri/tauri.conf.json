{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DailyNotch Linux",
  "version": "0.1.0",
  "identifier": "com.dailynotch.linux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "DailyNotch Linux",
        "width": 204,
        "height": 32,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "shadow": false,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "tasks",
        "title": "DailyNotch Tasks",
        "width": 800,
        "height": 550,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "shadow": false,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "DailyNotch Settings",
        "width": 800,
        "height": 550,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "shadow": false,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "A focused task tracker for Linux",
    "longDescription": "DailyNotch is a local-first focus and task tracker for Linux.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
